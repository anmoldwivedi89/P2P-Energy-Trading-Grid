# ==============================================================================
# GRID P2P Frontend Environment Configuration
# ==============================================================================

# Centralized Express Backend API Base URL
# (Authentication, marketplace listings, orders, and AI predictions all route through here)
#
# Local development default:
VITE_API_BASE_URL=http://localhost:5000/api
#
# Production (Render):
# VITE_API_BASE_URL=https://p2p-energy-trading-grid-backend.onrender.com/api

# Architectural notes:
# 1. WebSocket: Express backend operates via REST API; real-time socket connections are not currently used.
# 2. AI Service: Python ML predictions are called server-side by the Express backend. Direct frontend access is disabled.
# 3. Environment: Vite automatically determines production vs development mode during build/dev commands.
